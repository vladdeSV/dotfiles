#!/usr/bin/env zsh

# git in prompt
git_prompt_info() {
  if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) != "true" ]]; then
    return
  fi

  dynamic=""
  dynamic+="%f("
  dynamic+="%F{11}$(git symbolic-ref --short HEAD)%f"

  if ! git diff-index --cached --quiet HEAD -- 2>/dev/null; then
    dynamic+="%F{9}"
    dynamic+="?"
  fi

  if ! git diff-files --quiet 2>/dev/null; then
    dynamic+="%F{9}"
    dynamic+="!"
  fi

  if [[ -n $(git ls-files --others --exclude-standard | head -n 1) ]]; then
    dynamic+="%F{8}"
    dynamic+="."
  fi

  dynamic+="%f)"

  printf "%s" "$dynamic"
}
